*.py[cod]
.venv/
venv/
.pytest_cache/

# ── Compilación y salida ──────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.output/
.parcel-cache/
.turbo/
.cache/
*.tsbuildinfo
*.min.js.map

# ── Pruebas y cobertura ───────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ── Variables de entorno y secretos ───────────────────────────
