# ── Dependencias ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bower_components/
vendor/

# ── Python (si el backend lo usa) ─────────────────────────────
