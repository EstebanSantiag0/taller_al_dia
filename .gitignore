.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Bases de datos locales ────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal

# ── Registros ─────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Auxiliares de LaTeX (los PDF sí se versionan) ─────────────
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# ── Editores y sistema operativo ──────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.directory

# ── Claude Code (config personal, no del proyecto) ────────────
